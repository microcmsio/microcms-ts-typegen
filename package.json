{
  "name": "microcms-typegen",
  "version": "1.0.0",
  "description": "Generate TypeScript content types from microCMS Management API schemas",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/config.d.ts"
    }
  },
  "bin": {
    "microcms-typegen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "pretest": "npm run build",
    "pretest:types": "npm run build",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "test:types": "node scripts/check-typescript.mjs",
    "test:package": "node scripts/check-package.mjs",
    "typegen": "npm run build && node ./dist/cli.js generate",
    "typegen:check": "npm run build && node ./dist/cli.js check",
    "test:performance": "npm run build && node scripts/check-type-performance.mjs",
    "lint": "oxlint ./src ./test ./scripts ./examples ./microcms-typegen.config.example.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check ./src ./test ./scripts ./examples ./microcms-typegen.config.example.ts ./package.json ./tsconfig*.json ./.github ./.oxlintrc.json ./.prettierrc ./.c8rc.json",
    "format:fix": "prettier --write ./src ./test ./scripts ./examples ./microcms-typegen.config.example.ts ./package.json ./tsconfig*.json ./.github ./.oxlintrc.json ./.prettierrc ./.c8rc.json",
    "pretest:coverage": "npm run build -- --inlineSourceMap",
    "test:coverage": "c8 node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "microcms-typegen.config.example.ts"
  ]
}
